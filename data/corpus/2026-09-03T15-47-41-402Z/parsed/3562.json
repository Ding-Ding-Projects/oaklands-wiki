pacing pi-border-color\" data-source=\"Price\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Price</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">$990</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"Function\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Function</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Conveyor</div>\n</div>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t<section class=\"pi-item pi-group pi-border-color\">\n\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"Version Added\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Version Added</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Version 1.69.0</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Date Added</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">?</div>\n</div>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n</aside>\n\n<p class=\"mw-empty-elt\"></p><p><br />\n</p>\n<h2><span class=\"mw-headline\" id=\"Overview\">Overview</span></h2>\n<p>The <b>Extending Conveyor</b> is a conveyor that can be found and purchased at <a href=\"/wiki/Alan%27s_AutoLogistics\" title=\"Alan&#39;s AutoLogistics\">Alan's Autologistics</a> for $990. It's appearance is a green, unlabeled box found at the back of the store. When placed, it is a small conveyor strip and conveyor supports that shows the total area it is taking up.\n</p><p>When resized or stretched, the strip will stay the same size, but the conveyor supports will be resized. When the conveyor is activated, the conveyor will take up the conveyor support area, making a typical conveyor.\n</p>\n<h2><span class=\"mw-headline\" id=\"Usage\">Usage</span></h2>\n<p>This conveyor can be used for complex builds and precise builds, in which an unanchored item has to fall down.\n</p>\n<h3><span class=\"mw-headline\" id=\