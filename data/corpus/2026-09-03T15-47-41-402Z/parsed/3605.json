izontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"Ore\">Ore</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"Refined\">Refined</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"Forged\">Forged</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"Ore\">?$/studs</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"Refined\">$200/stud</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"Forged\">$320/stud</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t<section class=\"pi-item pi-group pi-border-color\">\n\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"Version Added\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Version Added</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">v.1.71.0</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Date Added</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">?</div>\n</div>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n</aside>\n\n<p class=\"mw-empty-elt\"></p><p><b>Sapphire</b> is a new ore found in <a href=\"/wiki/Darkslate\" title=\"Darkslate\">Darkslate</a> in the caves under the <a href=\"/wiki/Snowlands\" class=\"mw-redirect\" title=\"Snowlands\">Snowlands</a>. It looks similar to <a href=\"/wiki/Boomite\" title=\"Boomite\">Boomite</a> in that it has large dark blue crystal-like shapes protruding from the rocks surface.\n</p><p>When refined, <b>sapphire</b> takes on a slight translucent appearance, allowing a player to see through it. When forged, the <b>sapphire</b> ingot takes on a foil-like texture while still staying translucent.  \n</p><p><b>Sapphire</b> is most commonly found near the entrance to the <a href=\"/wiki/Ice_Golem_Shop\" title=\"Ice Golem Shop\">Ice Golem Shop</a> or underneath Giant Ice Crystals, which can be destroyed by use of a <a href=\"/wiki/Flamethrower\" title=\"Flamethrower\">Flamethrower</a> or an explosive or use of a <a href=\"/wiki/Icethrower\" title=\"Icethrower\">Icethrower</a>. \n</p><p><b>Sapphire's</b> price (though not listed in resource hub yet) is $200/stud refined, and $320/stud forged.\n</p>\n<!-- \nNewPP limit report\nCached time: 20260902170649\nCache expiry: 1209600\nReduced expiry: false\nComplications: []\nCPU time usage: 0.029 seconds\nReal time usage: 0.037 seconds\nPreprocessor visited node count: 56/1000000\nPost‐expand include size: 46/2097152 bytes\nTemplate argument size: 8/2097152 bytes\nHighest expansion depth: 5/100\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 28/5000000 bytes\nLua time usage: 0.006/7.000 seconds\nLua memory usage: 1019464/104857600 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   28.915      1 Template:Ore\n100.00%   28.915      1 -total\n-->\n\n<!-- Saved in parser cache with key 1.43.9_prod_oaklands:pcache:idhash:3605-0!sseVary=RegularPage!FandomDesktop!LegacyGalleries and timestamp 20260902170649 and revision id 21185. Rendering was triggered because: page-view\n -->\n</div>","categories":[],"links":[{"title":"Boomite","exists":true},{"title":"Darkslate","exists":true},{"title":"Flamethrower","exists":true},{"title":"Ice Golem Shop","exists":true},{"title":"Icethrower","exists":true},{"title":"Snowlands","exists":true}],"images":["Sapphire_Full.png","Refined_Sapphire.png","Forged_Sapphire.png"]}
