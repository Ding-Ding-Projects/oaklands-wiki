ource=\"Refined\">Refined</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"Forged\">Forged</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"Ore\">?$/studs</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"Refined\">~$62/Stud(needs testing)</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"Forged\">~$70/Stud(needs testing)</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t<section class=\"pi-item pi-group pi-border-color\">\n\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"Version Added\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Version Added</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">v1.51.0</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Date Added</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">March 1st, 2024</div>\n</div>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n</aside>\n\n<p class=\"mw-empty-elt\"></p><p><br />\n</p>\n<h2><span class=\"mw-headline\" id=\"Description\">Description</span></h2>\n<p><b>OpalBlue</b> can be found underwater in the tunnel river inside of <a href=\"/wiki/Blue_Clay\" title=\"Blue Clay\">Blue Clay</a>.\nAfter being refined, the name changes to Tide Opal.\n</p><p>It is one of three Opal ores, the others being <a href=\"/wiki/OpalBrown\" title=\"OpalBrown\">OpalBrown</a> and <a href=\"/wiki/OpalRed\" title=\"OpalRed\">OpalRed</a>.\n</p>\n<table class=\"navbox mw-collapsible\" style=\"background:#291F1D; width:100%; padding:.1em; margin:.5em auto; -webkit-border-rad