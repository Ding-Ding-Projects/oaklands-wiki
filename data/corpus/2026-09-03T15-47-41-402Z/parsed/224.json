al-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"Refined\">Refined</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"Forged\">Forged</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"Ore\">?$/studs</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"Refined\">$125/stud</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"Forged\">$175/stud</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t<section class=\"pi-item pi-group pi-border-color\">\n\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"Version Added\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Version Added</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">v1.0.0</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Date Added</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">January 14th, 2023</div>\n</div>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n</aside>\n\n<p class=\"mw-empty-elt\"></p><p><br />\n</p>\n<h2><span class=\"mw-headline\" id=\"Description\">Description</span></h2>\n<p><b>Mythril</b> spawns in <b><a href=\"/wiki/Lightslate\" title=\"Lightslate\">Lightslate</a></b>, <b><a href=\"/wiki/Beigeslate\" title=\"Beigeslate\">Beigeslate</a></b>, and <b><a href=\"/wiki/Darkslate\" title=\"Darkslate\">Darkslate</a>,</b> <a href=\"/wiki/Blueslate\" title=\"Blueslate\"><b>Chalkyslate</b></a>, <b><a href=\"/wiki/Blueslate\" title=\"Blueslate\">Blueslate</a></b>, and <b><a href=\"/wiki/Smokeslate\" title=\"Smokeslate\">Smokeslate</a>.</b>   \n</p><p>The raw form of <b>Mythril</b> takes on a deep cyan/teal color. Putting raw <b>Mythril</b> through a <b>refinery</b> raises the sell <b>value</b> to <b>$125/stud</b>. Putting <b>refined</b> <b>Mythril</b> through a <b>forge</b> further increases the value to <b>$175/stud</b>.  \n</p>\n<h2><span class=\"mw-headline\" id=\"Trivia\">Trivia</span></h2>\n<ul><li>Mythril is spelled incorrectly ingame; the proper spelling is <b>Mithril</b>.<sup id=\"cite&#95;ref-1\" class=\"reference\"><a href=\"#cite_note-1\"><span class=\"cite-bracket\">&#91;</span>1<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li>Mithril is a fictional metal, originating from J. R. R. Tolkien's Middle-earth writings, such as The Hobbit and The Lord of the Rings.<sup id=\"cite&#95;ref-2\" class=\"reference\"><a href=\"#cite_note-2\"><span class=\"cite-bracket\">&#91;</span>2<span class=\"cite-bracket\">&#93;</span></a></sup></li>\n<li>For a limited time in the testing servers, Mythril spawned in abundance near water.</li></ul>\n<table class=\"navbox mw-collapsible\" style=\"background:#291F1D; width:100%; padding:.1em; margin:.5em auto; -webkit-border-radius:5px; -moz-border-radius:0 10px 10px 0\" data-expandtext=\"Open\" data-collapsetext=\"Close\">\n<tbody><tr>\n<th style=\"width:105px; background:#140401; -webkit-border-radius:5px; -moz-border-radius:0 10px 10px 0\"><span style=\"float:left; padding-left:10px; padding-top:4px; font-size:90%\"><a href=\"/wiki/Template:Ore_Nav\" title=\"Template:Ore Nav\"><span title=\"View this template\">v</span></a> • <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://oaklands.fandom.com/wiki/Template_talk:Ore_Nav\"><span title=\"Discuss this template\">d</span></a> • <a target=\"_blank\" rel=\"noreferrer noopener\" class=\"text\" href=\"https://oaklands.fandom.com/wiki/Template:Ore_Nav?action=edit\"><span title=\"Edit this template\">e</span></a></span><figure class=\"mw-halign-center\" typeof