pi-border-color\" data-source=\"Island\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Region</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Finlay</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"Shop\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Shop</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">The Oak Depot</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"Price\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Price</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">$450</div>\n</div>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t<section class=\"pi-item pi-group pi-border-color\">\n\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"Version Added\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Version Added</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">1.45.0</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Date Added</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">December 10th, 2023</div>\n</div>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n</aside>\n<i><big>\"A festive stocking typically filled with surprises\"</big></i>\n<p class=\"mw-empty-elt\"></p>\n<h2><span class=\"mw-headline\" id=\"Stocking\">Stocking</span></h2>\n<p>The Stocking is a decorational item introduced in 1.45.0, or the Christmas Update. This item can also spawn in Gift Landings, the Christmas Update's version of <a href=\"/wiki/Meteor_Core\" title=\"Meteor Core\">Meteor Crashes</a>.\n</p>\n<h2><span class=\"mw-headline\" id=\"Trivia\">Trivia</span></h2>\n<ul><li>After clicking on the \"Inscribe Name\" button, the signature year will appear on the sock on one side, and the player's name on the other side.</li>\n<li>This item is based off of stockings in real life, commonly used during Christmas.</li></ul>\n<h2><span class=\"mw-headline\" id=\"Gallery\">Gallery</span></h2>\n<div id=\"gallery-1\" hash=\"cb67f1cdf399245f56e74cdf3485fba0\" data-seq-no=\"1\" class=\"wikia-gallery wikia-gallery-caption-below wikia-gallery-position-left wikia-gallery-spacing-medium wikia-gallery-border-small wikia-gallery-captions-left wikia-gallery-caption-size-medium\"><div class=\"wikia-gallery-caption\"></div><div class=\"wikia-gallery-item\" style=\"width:187px; \"><div class=\"thumb\" style=\"height:122px;\"><div class=\"gallery-image-wrapper accent\" id=\"Limited_in_Oak_Depot-png\" style=\"position: relative; height:120px; width:185px;\"><a class=\"image lightbox\" href=\"/wiki/File:Limited_in_Oak_Depot.png\" title=\"Limited in Oak Depot.png (485 KB)\" style=\"height:120px; width:185px;\"><noscript><img style=\"\" src=\"https://static.wikia.nocookie.net/oaklands/images/a/ac/Limited_in_Oak_Depot.png/revision/latest/scale-to-width-down/185?cb=20231214125403\" title=\"Limited in Oak Depot.png (485 KB)\" class=\"thumbimage\" alt=\"Stocking in Oak Depot\" height=\"120\" width=\"185\" data-image-name=\"Limited in Oak Depot.png\" data-image-key=\"Limited_in_Oak_Depot.png\" data-relevant=\"1\" data-caption=\"Stocking in Oak Depot\"></noscript><img style=\"\" src=\"data:image/gif;base64,R0lGODlhAQABAIABAAAAAP///yH5BAEAAAEALAAAAAABAAEAQAICTAEAOw%3D%3D\" title=\"Limited in Oak Depot.png (485 KB)\" class=\"thumbimage lazyload\" alt=\"Stocking in Oak Depot\" height=\"120\" width=\"185\" data-image-name=\"Limited in Oak Depot.png\" data-image-key=\"Limited_in_Oak_Depot.png\" data-relevant=\"1\" data-caption=\"Stocking in Oak Depot\" data-src=\"https://static.wikia.nocookie.net/oaklands/images/a/ac/Limited_in_Oak_Depot.png/revision/latest/scale-to-width-down/185?cb=20231214125403\" /></a></div></div><div class=\"lightbox-caption\" style=\"width:185px;\">Stocking in Oak Depot</div></div></div>\n<!-- \nNewPP limit report\nCached time: 20260903082546\nCache expiry: 2592000\nReduced expi