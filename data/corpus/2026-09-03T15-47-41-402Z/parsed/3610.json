al-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"Refined\">Refined</th>\n\t\t\n\t\t\t<th class=\"pi-horizontal-group-item pi-data-label pi-secondary-font pi-border-color pi-item-spacing\" data-source=\"Forged\">Forged</th>\n\t\t\n\t\t</tr>\n\t</thead>\n\t\n\t<tbody>\n\t<tr>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"Stone\">~16/stud</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"Refined\">~122/stud</td>\n\t\n\t\t<td class=\"pi-horizontal-group-item pi-data-value pi-font pi-border-color pi-item-spacing\" data-source=\"Forged\">~307/stud</td>\n\t\n\t</tr>\n\t</tbody>\n</table>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t\t\t<div class=\"wds-tab__content\">\n\t\t\t\t<section class=\"pi-item pi-group pi-border-color\">\n\t\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"Version Added\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Version Added</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">1.71.0</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Date Added</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">December 1st, 2024</div>\n</div>\n\n<div class=\"pi-item pi-data pi-item-spacing pi-border-color\" data-source=\"Status\">\n\t\n\t\t<h3 class=\"pi-data-label pi-secondary-font\">Status</h3>\n\t\n\t<div class=\"pi-data-value pi-font\">Obtainable</div>\n</div>\n\n</section>\n\n\t\t\t</div>\n\t\t\n\t</section>\n\n\n\n</aside>\n\n<p class=\"mw-empty-elt\"></p>\n<h2><span class=\"mw-headline\" id=\"Description\">Description</span></h2>\n<p>Aurore is a type of special ore that only spawns in the <a href=\"/wiki/Icelands\" title=\"Icelands\">Icelands</a> during an aurora, and can only be mined with an <a href=\"/wiki/Auroracrest_Pickaxe\" title=\"Auroracrest Pickaxe\">Auroracrest Pickaxe</a>\n</p><p>In it's refined state, this is called \"Ore\" but when forged, it goes back to its original name of \"Aurore\"\n</p>\n<h2><span class=\"mw-headline\" id=\"Appearance\">Appearance</span></h2>\n<p>The ore itself is a pink (7e018f) translucent material. When refined, it becomes semi-translucent and takes on the Roblox Lego texture. The forged version loses all transparency and becomes a violent hot pink\n</p><p>When used in a schematic, the base stone retains its transparency and the forged version retains all its properties\n</p><p>As of 1.71.0, the forged version is very bugged, and when completed into a schematic, the schematic remains in its uncompleted color, but when moved or resized, it gives the wrong texture, similar to sanded birch, except more white, and can also be resized to be any size if the schematic is completed, regardless of how much material is in the schematic.\n</p>\n<!-- \nNewPP limit report\nCached time: 20260903150213\nCache expiry: 2592000\nReduced expiry: false\nComplications: []\nCPU time usage: 0.025 seconds\nReal time usage: 0.032 seconds\nPreprocessor visited node count: 72/1000000\nPost‐expand include size: 59/2097152 bytes\nTemplate argument size: 6/2097152 bytes\nHighest expansion depth: 5/100\nExpensive parser function count: 0/100\nUnstrip recursion depth: 0/20\nUnstrip post‐expand size: 28/5000000 bytes\nLua time usage: 0.005/7.000 seconds\nLua memory usage: 1019395/104857600 bytes\n-->\n<!--\nTransclusion expansion time report (%,ms,calls,template)\n100.00%   26.562      1 Template:Stone\n100.00%   26.562      1 -total\n-->\n\n<!-- Saved in parser cache with key 1.43.9_prod_oaklands:pcache:idhash:3610-0!sseVary=RegularPage!FandomDesktop!LegacyGalleries and timestamp 20260903150213 and revision id 17887. Rendering was triggered because: unknown\n -->\n</div>","categories":["Ores"],"links":[{"title":"Auroracrest Pickaxe","exists":true},{"title":"Icelands","exists":true}],"images":["Aurore.png","Refin