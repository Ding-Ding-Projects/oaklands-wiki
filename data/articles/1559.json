tr></tbody></table></div>\n<h3 id=\"processors\">Processors</h3>\n<div class=\"ok-tablewrap\"><table>\n<tbody><tr>\n<th>Name</th>\n<th>Picture</th>\n<th>Price\n</th></tr>\n<tr>\n<td><a href=\"__BASE__/wiki/Computer/\">Computer</a></td>\n<td><figure typeof=\"mw:File\"><span role=\"img\" aria-label=\"Media not yet archived: Calculator boxed\">Calculator boxed</span><figcaption></figcaption></figure></td>\n<td>$550\n</td></tr>\n<tr>\n<td><a href=\"__BASE__/wiki/Sustainer/\">Sustainer</a></td>\n<td><figure typeof=\"mw:File\"><span role=\"img\" aria-label=\"Media not yet archived: Sustainer boxed\">Sustainer boxed</span><figcaption></figcaption></figure></td>\n<td>$520\n</td></tr>\n<tr>\n<td><a href=\"__BASE__/wiki/Relay/\">Relay</a></td>\n<td><figure typeof=\"mw:File\"><span role=\"img\" aria-label=\"Media not yet archived: Relay boxed\">Relay boxed</span><figcaption></figcaption></figure></td>\n<td>$550\n</td></tr>\n<tr>\n<td><a href=\"__BASE__/wiki/Zero_Tick/\">Zero Tick</a></td>\n<td><figure typeof=\"mw:File\"><span role=\"img\" aria-label=\"Media not yet archived: Zero Tick boxed\">Zero Tick boxed</span><figcaption></figcaption></figure></td>\n<td>$175\n</td></tr>\n<tr>\n<td><a href=\"__BASE__/wiki/Number_Interface/\">Number Interface</a></td>\n<td><figure typeof=\"mw:File\"><span role=\"img\" aria-label=\"Media not yet archived: Number Interface boxed\">Number Interface boxed</span><figcaption></figcaption></figure></td>\n<td>$520\n</td></tr>\n<tr>\n<td><a href=\"__BASE__/wiki/Delay/\">Delay</a></td>\n<td><figure typeof=\"mw:File\"><span role=\"img\" aria-label=\"Media not yet archived: Delay boxed\">Delay boxed</span><figcaption></figcaption></figure></td>\n<td>$520\n</td></tr>\n<tr>\n<td><a href=\"__BASE__/wiki/Frequency_Clock/\">Frequency Clock</a></td>\n<td><figure typeof=\"mw:File\"><span role=\"img\" aria-label=\"Media not yet archived: Frequency Clock boxed\">Frequency Clock boxed</span><figcaption></figcaption></figure></td>\n<td>$520\n</td></tr>\n<tr>\n<td